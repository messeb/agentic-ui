# Copy to .env and adjust. All backend vars use the DEMO_ prefix.

# --- Backend (FastAPI) ---
DEMO_ENVIRONMENT=development
DEMO_HOST=0.0.0.0
DEMO_PORT=8000
DEMO_RELOAD=true
# Absolute path to the shared manifest (defaults to demo/shared/approaches.json).
# DEMO_APPROACHES_MANIFEST=/abs/path/to/demo/shared/approaches.json
# JSON array of allowed CORS origins.
# DEMO_CORS_ORIGINS=["http://localhost:3000"]

# --- Frontend (Nuxt) ---
NUXT_PUBLIC_API_BASE=http://localhost:8000

# --- LLM: any OpenAI-compatible chat-completions API (chat-API-agnostic) ---
# Three OPENAI_* variables. The backend proxies all calls, so the key never reaches the frontend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional — the endpoint. Omit for OpenAI's default host; otherwise point it at any endpoint that
# speaks the OpenAI chat API (Azure OpenAI's OpenAI-compatible v1 endpoint, Ollama, vLLM, …):
# OPENAI_BASE_URL=http://localhost:11434/v1
