# Copy to .env and adjust. All backend vars use the DEMO_ prefix.

# --- Backend (FastAPI) ---
DEMO_ENVIRONMENT=development
DEMO_HOST=0.0.0.0
DEMO_PORT=8000
DEMO_RELOAD=true
# Absolute path to the shared manifest (defaults to demo/shared/approaches.json).
# DEMO_APPROACHES_MANIFEST=/abs/path/to/demo/shared/approaches.json
# JSON array of allowed CORS origins.
# DEMO_CORS_ORIGINS=["http://localhost:3000"]

# --- Frontend (Nuxt) ---
NUXT_PUBLIC_API_BASE=http://localhost:8000

# --- LLM keys (only needed once you START implementing an approach) ---
# Never ship a key to the frontend — the backend proxies all model calls.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
