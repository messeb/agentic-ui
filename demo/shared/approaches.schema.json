{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/your-org/agentic-ui-demo/shared/approaches.schema.json",
  "title": "Agentic UI approaches manifest",
  "type": "object",
  "required": ["version", "approaches"],
  "additionalProperties": true,
  "properties": {
    "version": { "type": "string" },
    "description": { "type": "string" },
    "approaches": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id", "number", "title", "tagline", "input", "output",
          "howItWorks", "whatYouNeed", "agenticLevel", "maturity", "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "number": { "type": "integer", "minimum": 1, "maximum": 8 },
          "title": { "type": "string" },
          "tagline": { "type": "string" },
          "input": { "type": "string" },
          "output": { "type": "string" },
          "howItWorks": { "type": "string" },
          "whatYouNeed": { "type": "array", "items": { "type": "string" } },
          "agenticLevel": { "type": "integer", "minimum": 0, "maximum": 5 },
          "maturity": {
            "type": "string",
            "enum": ["proven", "established", "emerging", "paused", "least-mature"]
          },
          "status": { "type": "string", "enum": ["not-implemented", "in-progress", "implemented"] }
        }
      }
    }
  }
}
